---
import { site, nav } from '../data/site';
import { u } from '../lib/url';
import ThemeToggle from './ThemeToggle.astro';
interface Props { current?: string }
const { current } = Astro.props;
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href={u()}>
      <span class="brand__mark" aria-hidden="true">AA</span>
      <span>{site.name}</span>
    </a>
    <nav class="nav-desktop" aria-label="Primary">
      {nav.map((n) => <a href={u(n.path)} aria-current={current === n.label ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    <div class="header-actions">
      <ThemeToggle />
      <a class="btn btn--primary btn--small" href={u('contact/')}>Contact</a>
      <details class="menu-mobile">
        <summary><span class="open">Menu</span><span class="close">Close</span></summary>
        <div class="menu-panel">
          <nav aria-label="Primary mobile">
            <ul>
              {nav.map((n) => <li><a href={u(n.path)} aria-current={current === n.label ? 'page' : undefined}>{n.label}</a></li>)}
            </ul>
          </nav>
          <a class="btn btn--primary" href={u('contact/')}>Contact</a>
          <div class="theme-row"><span class="label">Theme</span><ThemeToggle /></div>
        </div>
      </details>
    </div>
  </div>
</header>
