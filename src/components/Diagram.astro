---
// Decorative, illustrative thumbnails. Colour comes from the surrounding text colour.
interface Props { kind: 'pipeline' | 'loop' | 'merge' | 'db' | 'dist' | 'bars' }
const { kind } = Astro.props;
---
<svg viewBox="0 0 240 96" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {kind === 'pipeline' && (<>
    {[0, 1, 2, 3].map((i) => <rect x={10 + i * 58} y="30" width="44" height="36" rx="7" />)}
    {[0, 1, 2].map((i) => <path d={`M${54 + i * 58} 48h14m-5-4 5 4-5 4`} />)}
  </>)}
  {kind === 'loop' && (<>
    <path d="M60 48l50-26h20l50 26-50 26h-20z" opacity=".55" />
    {[[60, 48], [110, 22], [130, 22], [180, 48], [130, 74], [110, 74]].map(([x, y]) => <circle cx={x} cy={y} r="8" fill="var(--tile)" />)}
  </>)}
  {kind === 'merge' && (<>
    {[0, 1, 2, 3].map((i) => <rect x="14" y={10 + i * 21} width="52" height="14" rx="4" />)}
    {[0, 1, 2, 3].map((i) => <path d={`M66 ${17 + i * 21}C110 ${17 + i * 21} 120 48 150 48`} opacity=".7" />)}
    <rect x="150" y="26" width="76" height="44" rx="10" />
  </>)}
  {kind === 'db' && (<>
    <path d="M30 32c0-7 22-12 46-12s46 5 46 12v32c0 7-22 12-46 12S30 71 30 64z" />
    <path d="M30 44c0 7 22 12 46 12s46-5 46-12M30 54c0 7 22 12 46 12s46-5 46-12" />
    {[28, 46, 20, 38].map((h, i) => <rect x={140 + i * 24} y={78 - h} width="14" height={h} rx="3" />)}
  </>)}
  {kind === 'dist' && (<>
    <path d="M14 76c46 0 60-56 106-56s60 56 106 56" />
    <path d="M14 80h212" opacity=".5" />
    <path d="M120 20v60" stroke-dasharray="5 5" opacity=".7" />
  </>)}
  {kind === 'bars' && (<>
    <path d="M30 80h180" opacity=".5" />
    {[24, 46, 62].map((h, i) => <rect x={64 + i * 44} y={80 - h} width="30" height={h} rx="6" />)}
  </>)}
</svg>
