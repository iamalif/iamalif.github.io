---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Diagram from '../components/Diagram.astro';
import Contour from '../components/Contour.astro';
import { site, now, career, education, focus } from '../data/site';
import { u, absolute } from '../lib/url';

const work = (await getCollection('work')).filter((e) => e.data.featured && !e.data.draft).sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('projects')).filter((e) => e.data.featured && !e.data.draft).sort((a, b) => a.data.order - b.data.order);
const feature = projects[0];
const side = projects.slice(1, 3);
const fig = feature?.data.findings?.figure;
---
<Base title={site.name} path="" jsonLd={{ '@context': 'https://schema.org', '@type': 'Person', name: site.name, jobTitle: site.title, email: site.email, url: absolute(''), address: { '@type': 'PostalAddress', addressLocality: 'Borlänge', addressCountry: 'SE' }, worksFor: { '@type': 'Organization', name: 'Digital Authority Partners' }, alumniOf: { '@type': 'CollegeOrUniversity', name: 'BRAC University' }, affiliation: { '@type': 'CollegeOrUniversity', name: 'Dalarna University' }, sameAs: [site.linkedin, site.github] }}>
  <div class="wrap">
    <div class="bento" style="margin-top: clamp(1.5rem, 3vw, 2.25rem)">
      <section class="tile tile--grad hero" aria-labelledby="top">
        <p class="label label--accent">// Head of Development &amp; AI</p>
        <h1 id="top">
          <span class="visually-hidden">Al Amin Alif: </span>
          <span>I lead software</span>
          <span class="grad-text">and AI delivery.</span>
        </h1>
        <p class="lead">{site.lead}</p>
        <p class="place">{site.place}</p>
        <div class="compact">
          <p class="meta">{site.availability}. {site.authorisation}.</p>
          <ul class="focus-list" aria-label="Focus areas">{focus.slice(0, 5).map((f) => <li>{f}</li>)}</ul>
        </div>
        <div class="actions">
          <a class="btn btn--primary" href={u('work/')}>View selected work</a>
          <a class="btn btn--ghost" href={u('contact/')}>Contact me</a>
          <div class="chip-links">
            <a class="chip" href={u('cv/')}>CV</a>
            <a class="chip" href={site.github}>GitHub</a>
            <a class="chip" href={site.linkedin}>LinkedIn</a>
          </div>
        </div>
      </section>

      <section class="tile now" aria-labelledby="now-h">
        <h2 id="now-h" class="visually-hidden">Current roles</h2>
        <p class="pill"><span class="dot" aria-hidden="true"></span>{site.availability}</p>
        <ol class="timeline">
          {now.map((n) => (
            <li>
              <span class="label">{n.tag}</span>
              <strong>{n.role}</strong>
              <span class="sub">{n.org}</span>
              <span class="when">{n.dates}</span>
            </li>
          ))}
        </ol>
      </section>

      <section class="tile profile" aria-label="Location">
        <Contour />
        <span class="label">Location</span>
        <div>
          <h2>Borlänge, Sweden</h2>
          <p class="muted">{site.authorisation}.</p>
        </div>
      </section>
      <section class="tile profile" aria-label="Focus areas">
        <span class="label">Focus</span>
        <ul class="focus-list">{focus.map((f) => <li>{f}</li>)}</ul>
      </section>
      <section class="tile profile" aria-label="Profile links">
        <div class="portrait">
          <div class="portrait__ph" aria-hidden="true">AA</div>
          <div><strong style="font-size:1.25rem">{site.name}</strong><br /><span class="label">Portrait placeholder</span></div>
        </div>
        <div>
          <div class="chip-links">
            <a class="chip" href={u('cv/')}>CV (PDF)</a>
            <a class="chip" href={site.github}>GitHub</a>
            <a class="chip" href={site.linkedin}>LinkedIn</a>
          </div>
          <p class="muted" style="margin-top:0.75rem;overflow-wrap:anywhere">{site.email}</p>
        </div>
      </section>
    </div>

    <section class="section" id="selected-work" aria-labelledby="work-h">
      <div class="section-head">
        <div><span class="label label--warm">// Delivery</span><h2 id="work-h">Selected delivery work</h2></div>
        <a class="arrow-link" href={u('work/')}>All delivery work</a>
      </div>
      <div class="cards">
        {work.map((e) => (
          <ProjectCard title={e.data.title} summary={e.data.summary} role={e.data.role} context={e.data.context} dates={e.data.dates}
            href={u(`work/${e.id}/`)} kind={e.data.diagramKind} tags={e.data.tags} scope={e.data.scope} draft={e.data.draft} />
        ))}
      </div>
    </section>

    <section class="section" aria-labelledby="tech-h">
      <div class="section-head">
        <div><span class="label label--warm">// Projects</span><h2 id="tech-h">Selected technical projects</h2></div>
        <a class="arrow-link" href={u('projects/')}>All projects</a>
      </div>
      <div class="tech-bento">
        {feature && (
          <article class="tile tile--grad tech-feature">
            <div class="stack">
              <p><span class="chip chip--role">{feature.data.role}</span></p>
              <p class="meta">{[feature.data.context, feature.data.dates].filter(Boolean).join(' · ')}</p>
              <h3><a href={u(`projects/${feature.id}/`)}>{feature.data.title}</a></h3>
              <p>{feature.data.summary}</p>
              <p class="scope">{feature.data.scope.map((s, i) => <>{i > 0 && ' · '}<b>{s.value}</b> {s.label}</>)} (dataset scope)</p>
              <ul class="tags" aria-label="Tools">{feature.data.tags.map((t) => <li>{t}</li>)}</ul>
              <span class="card__more" aria-hidden="true">Read the project page</span>
            </div>
            {fig && (
              <figure>
                <div class="plate"><Image src={fig.src} alt={fig.alt} widths={[480, 800, 1050]} sizes="(max-width: 1100px) 90vw, 760px" loading="lazy" /></div>
                <figcaption class="plate-caption">{fig.caption}</figcaption>
                {feature.data.findings && <div class="eval eval--small"><p>{feature.data.findings.evaluationContext}</p></div>}
              </figure>
            )}
          </article>
        )}
        {side.map((e) => (
          <article class="tile tech-side">
            <p><span class="chip chip--role">{e.data.role}</span></p>
            <p class="meta">{[e.data.context, e.data.dates].filter(Boolean).join(' · ')}</p>
            <h3><a href={u(`projects/${e.id}/`)}>{e.data.title}</a></h3>
            <p>{e.data.summary}</p>
            <div class="thumb">
              {e.data.thumb ? (
                <div class="plate"><Image src={e.data.thumb} alt={e.data.thumbAlt ?? ''} widths={[112, 224]} sizes="112px" loading="lazy" /></div>
              ) : (
                <div class="card__panel" style="width:112px;aspect-ratio:240/96"><Diagram kind={e.data.diagramKind} /></div>
              )}
              <span class="scope" style="flex:1">{e.data.scope.length ? e.data.scope.map((s, i) => <>{i > 0 && ' · '}<b>{s.value}</b> {s.label}</>) : e.data.tags.slice(0, 3).join(', ')}</span>
            </div>
            {e.data.draft && <p><span class="badge-draft">Page in preparation</span></p>}
          </article>
        ))}
      </div>
    </section>

    <section class="section" aria-labelledby="browse-h">
      <div class="tile browse">
        <div>
          <span class="label label--warm">// Everything else</span>
          <h2 id="browse-h">Browse the full portfolio</h2>
        </div>
        <div class="actions">
          <a class="btn btn--primary" href={u('work/')}>Delivery work</a>
          <a class="btn btn--ghost" href={u('projects/')}>Data and technical projects</a>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="career-h">
      <div class="section-head"><div><span class="label label--warm">// Background</span><h2 id="career-h">Career and education</h2></div><a class="arrow-link" href={u('cv/')}>Full CV</a></div>
      <div class="two-col">
        <div class="tile">
          <span class="label">Experience</span>
          <ul class="rows">{career.map((c) => <li><b>{c.org}</b><span class="when">{c.dates}</span><span class="sub">{c.role}</span></li>)}</ul>
        </div>
        <div class="tile">
          <span class="label">Education</span>
          <ul class="rows">{education.map((c) => <li><b>{c.org}</b><span class="when">{c.dates}</span><span class="sub">{c.role}</span></li>)}</ul>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="contact-h">
      <div class="tile tile--grad contact-tile">
        <div>
          <span class="label label--warm">// Get in touch</span>
          <h2 id="contact-h" class="grad-text" style="display:inline-block">Let's talk.</h2>
          <p class="muted" style="margin-top:1rem;max-width:30rem">Open to opportunities in Sweden in development leadership, technical project management, and AI and software delivery. {site.authorisation}.</p>
        </div>
        <div class="contact-list">
          <a class="contact-item" href={`mailto:${site.email}`}><span class="label">Email</span><strong>{site.email}</strong></a>
          <a class="contact-item" href={`tel:${site.phone.replace(/\s/g, '')}`}><span class="label">Phone</span><strong>{site.phone}</strong></a>
          <div class="contact-actions">
            <a class="btn btn--ghost btn--small" href={site.linkedin}>LinkedIn</a>
            <a class="btn btn--ghost btn--small" href={site.github}>GitHub</a>
            <a class="btn btn--ghost btn--small" href={u('cv/')}>CV</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>
