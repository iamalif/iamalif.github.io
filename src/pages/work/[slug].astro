---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkDetail from '../../components/WorkDetail.astro';

export async function getStaticPaths() {
  const all = (await getCollection('work', (e) => e.data.hasPage && !e.data.draft)).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, next: all[(i + 1) % all.length] } }));
}
const { entry, next } = Astro.props;
---
<Base title={entry.data.title} description={entry.data.summary} path={`work/${entry.id}/`} current="Work">
  <WorkDetail entry={entry} next={next.id === entry.id ? undefined : next} />
</Base>
